# Normalize to LF in the repository and check out LF everywhere. Without
# this, a tool or editor that rewrites the tree to CRLF shows up as every
# file being modified (core.autocrlf is false), and a stray `git add -A`
# commits the churn and destroys `git blame`. The `binary` rules below
# still win for the fixtures they match.
* text=auto eol=lf

# Binary fixtures — never line-ending-convert.
*.pdf binary
*.step binary
*.wrl binary
*.png binary

# Native-format fixture corpus: byte-for-byte goldens, never converted.
crates/signex-types/tests/corpus/** text eol=lf

# Routing corpus (#2481): third-party boards, large, stored in Git LFS. The
# routing tests skip a board whose LFS object was not fetched.
testdata/routing-corpus/**/*.snxpcb filter=lfs diff=lfs merge=lfs -text
