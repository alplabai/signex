# Code owners — auto-requested as reviewers when matching paths change.
# Order matters: the LAST matching pattern wins for a given file.
# Both maintainers own the repo by default; the overrides below route
# domain-specific changes to whoever knows that area best.

# Default: either maintainer can review anything.
*                                               @hkngln @alpCaner

# Footprint editor, sketch geometry, and pad baking — Caner's domain.
/crates/signex-sketch/                          @alpCaner
/crates/signex-bake/                            @alpCaner
/crates/signex-app/src/library/editor/footprint/ @alpCaner

# CI, licensing, and repo governance — Hakan's domain.
/.github/                                        @hkngln
/scripts/ci_build_needed.sh                      @hkngln
/deny.toml                                       @hkngln
/docs/LICENSING.md                               @hkngln
/CONTRIBUTING.md                                 @hkngln

# The accepted command ids (#2447): removing a line removes a command, so
# both maintainers own it, whatever overrides are added above.
/scripts/catalog-ids.txt                         @hkngln @alpCaner

# The UI-free state ratchet (ADR-0006, #2494): listing a module as UI-free or
# raising the baseline needs a maintainer's approval.
/scripts/uifree-state.txt                        @hkngln @alpCaner
/scripts/uifree-state-baseline.txt               @hkngln @alpCaner

# The application core and its closure guard (#2326, ADR-0006 H7): a type in
# app/core/, a new root or a baseline change needs a maintainer's approval.
# `*` above already names both; these lines record the intent and must stay
# if a narrower owner is ever added above. state/mod.rs holds DocumentState,
# the root source; the .awk and .yml are the guard's own dependencies.
/crates/signex-app/src/app/core/                 @hkngln @alpCaner
/crates/signex-app/src/app/core.rs               @hkngln @alpCaner
/crates/signex-app/src/app/state/mod.rs          @hkngln @alpCaner
/scripts/check_core_closure.sh                   @hkngln @alpCaner
/scripts/test_check_core_closure.sh              @hkngln @alpCaner
/scripts/core-closure-roots.txt                  @hkngln @alpCaner
/scripts/core-closure-baseline.txt               @hkngln @alpCaner
/scripts/check_core_guard.awk                    @hkngln @alpCaner
/scripts/uifree-test-item.yml                    @hkngln @alpCaner

# The edit-tail wrapper exception (#2704): the list may only shrink, and its
# cap and name checksum live in the guard, so both need a maintainer.
/scripts/check_sheet_change_seam.sh              @hkngln @alpCaner
/scripts/sheet-change-wrappers.txt               @hkngln @alpCaner

# The load wrapper exception (#2704, #2326 slice 3): same rule as above.
/scripts/check_document_load_seam.sh             @hkngln @alpCaner
/scripts/document-load-wrappers.txt              @hkngln @alpCaner
