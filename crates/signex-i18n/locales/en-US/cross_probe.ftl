# Cross Probe and Cross Select Mode between the schematic and the board (#1312).

# Heading of the notice card when a Cross Probe finds nothing to show.
cross-probe-title = Cross Probe
cross-probe-nothing-selected = Select a part or a net on the sheet or the board first.
cross-probe-no-board = This project has no board to cross probe to.
cross-probe-no-match-board = Nothing on the board is linked to the selection.
cross-probe-no-match-schematic = Nothing in the schematic is linked to the selection.
cross-probe-sheet-unknown = The sheet of the selection is not known yet; open the project's sheets and try again.
# Messages panel lines when Tools ▸ Cross Select Mode is switched.
cross-select-on = Cross Select Mode is on: a selection on the sheet or the board is selected on the other side too.
cross-select-off = Cross Select Mode is off.
