# Snap ▾ on a board sketch: snapping to the board under the sketch
# (#2518). A board-feature snap places the point only; it adds no
# constraint. The footprint sketch does not show these rows.

# Heading of the rows.
sketch-snap-board-header = Board features
# The one switch for every row below it.
sketch-snap-board-all = Snap to board features
# One row per kind of board feature.
sketch-snap-board-outline = Board outline
sketch-snap-board-pads = Pad centres
sketch-snap-board-holes = Hole centres
sketch-snap-board-vias = Via centres
sketch-snap-board-track-ends = Track ends
sketch-snap-board-courtyards = Courtyard corners

# Snap ▾ in sketch mode, on both hosts (#188): snaps that land a
# constraint when a drawing tool clicks there.
sketch-snap-inference-header = Sketch snaps
# A Line's midpoint; the click lands a Midpoint constraint.
sketch-snap-midpoints = Line midpoints
# A Circle's or Arc's centre; the click lands a Coincident on it.
sketch-snap-centres = Circle and arc centres
