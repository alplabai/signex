# The Language setting in Preferences.

# Each language is named in its own language (its endonym) in every UI
# language, so a user who cannot read the current one can still find theirs.
# Terms are not translated per locale: the name is a fixed fact of the language.
-lang-en-us = English (United States)
-lang-en-xa = English (pseudo-locale)

# One message per term, because a term cannot be formatted on its own.
language-name-en-us = { -lang-en-us }
language-name-en-xa = { -lang-en-xa }

# Label of the Language row in Preferences.
settings-language = Language

# Help text under the Language label in Preferences.
settings-language-help = The language of menus and messages. Files Signex writes do not change with it.

# The first entry of the language list: follow the operating system.
language-system-default = System default
