# Native file dialogs (#2058): the window title and the name of each file
# type filter. The operating system draws the rest of the dialog. The
# extension lists are not part of these messages.

## Window titles

file-dialog-open-project = Open Project or Schematic
file-dialog-import-altium = Import Altium Project
file-dialog-import-dxf = Import DXF Drawing
file-dialog-new-project = New { -brand-name } Project (a folder named after the project is created)
file-dialog-save-schematic-as = Save Schematic As
file-dialog-export-pdf = Export PDF
file-dialog-export-bom = Export Bill of Materials
file-dialog-export-erc-report = Export ERC Report
file-dialog-export-netlist = Export Netlist
# Picks the .snxout file to run (#1299).
file-dialog-run-output-job = Run Export Job
# Picks the folder the PNG pages go to (#1299).
file-dialog-export-sheet-png = Export Pages as PNG
file-dialog-import-shortcuts = Import { -brand-name } Keyboard Shortcuts
file-dialog-export-shortcuts = Export { -brand-name } Keyboard Shortcuts
# Picks a library folder ending in .snxlib.
file-dialog-open-library = Open Library (*.snxlib/)
file-dialog-create-sheet = Create Sheet
file-dialog-pick-symbol = Pick Symbol (*.snxsym)
file-dialog-pick-footprint = Pick Footprint (*.snxfpt)
file-dialog-pick-sim-model = Pick Sim Model (*.snxsim)
file-dialog-pick-primitive = Pick Primitive
file-dialog-add-existing = Add Existing to Project
file-dialog-add-new-schematic = Add New Schematic to Project
file-dialog-new-symbol-library = New Symbol Library
file-dialog-new-pcb-library = New PCB Library
file-dialog-save-footprint-as = Save Footprint As
file-dialog-save-symbol-as = Save Symbol As
file-dialog-new-library = New Library
file-dialog-locate-library = Locate Library (*.snxlib)
file-dialog-pin-datasheet = Pin datasheet PDF
file-dialog-add-library = Add Library (*.snxlib)
file-dialog-new-component-library = New Component Library
# Place Design Block (#1667): a sheet whose content lands on the cursor.
file-dialog-place-design-block = Place Design Block
# Import Graphics (#1667): lines, circles, arcs and polylines from a DXF file.
file-dialog-import-graphics = Import Graphics

